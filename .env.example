# Paste your Discord Bot Token below
DISCORD_TOKEN=your_bot_token_here

# Bot Owner Discord ID (optional, bypasses all security checks)
OWNER_ID=your_discord_user_id_here

# Spotify API Credentials (optional, for direct Spotify metadata fetching)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
PORT=10000

# Lavalink v4.2.2 Audio Server Configuration
LAVALINK_HOST=thor-apex-lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=your_secure_lavalink_password_here
LAVALINK_SECURE=false

